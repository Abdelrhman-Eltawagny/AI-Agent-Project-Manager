# Copy to .env and adjust. Never commit the real .env file.

# Required by docker-compose.prod.yml and recommended for server.py:
# shared key sent by clients in the x-api-key header
API_KEY=change-me

# Ollama model used by the web assistant (docker-compose default: qwen2.5:7b)
PM_MODEL=qwen2.5:7b

# Optional overrides
# PM_OLLAMA_URL=http://localhost:11434
# PLAN_PATH=plan/final_project_plan.json
