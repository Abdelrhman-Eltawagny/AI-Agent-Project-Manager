<mxfile host="app.diagrams.net"><diagram name="Agents and Orchestrator" id="agents"><mxGraphModel dx="1400" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="650"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="orch" value='&lt;b&gt;Orchestrator&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;decides next action · runs agent · validates &amp; merges · checkpoints&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="500" y="30" width="400" height="96" as="geometry"/></mxCell><mxCell id="g_understand" value="Phase 1 · Understand" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;dashPattern=7 4;fillColor=none;strokeColor=#6C8EBF;fontColor=#6C8EBF;fontStyle=1;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="310" height="202" as="geometry"/></mxCell><mxCell id="a1" value='&lt;b&gt;1 · Requirements Analyst&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;extracts facts &amp; requirements&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="g_understand"><mxGeometry x="20.0" y="44" width="270" height="62" as="geometry"/></mxCell><mxCell id="a2" value='&lt;b&gt;2 · Epic Planner&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;groups requirements into epics&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="g_understand"><mxGeometry x="20.0" y="120" width="270" height="62" as="geometry"/></mxCell><mxCell id="g_plan" value="Phase 2 · Plan" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;dashPattern=7 4;fillColor=none;strokeColor=#82B366;fontColor=#82B366;fontStyle=1;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="370" y="240" width="310" height="354" as="geometry"/></mxCell><mxCell id="a3" value='&lt;b&gt;3 · Task Planner&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;breaks epics into tasks&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="g_plan"><mxGeometry x="20.0" y="44" width="270" height="62" as="geometry"/></mxCell><mxCell id="a4" value='&lt;b&gt;4 · Dependency Planner&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;finds blocking relations&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="g_plan"><mxGeometry x="20.0" y="120" width="270" height="62" as="geometry"/></mxCell><mxCell id="a5" value='&lt;b&gt;5 · Priority Planner&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;ranks tasks by value &amp; risk&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="g_plan"><mxGeometry x="20.0" y="196" width="270" height="62" as="geometry"/></mxCell><mxCell id="a6" value='&lt;b&gt;6 · Risk Analyst&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;identifies risks &amp; mitigations&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="g_plan"><mxGeometry x="20.0" y="272" width="270" height="62" as="geometry"/></mxCell><mxCell id="g_schedule" value="Phase 3 · Schedule" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;dashPattern=7 4;fillColor=none;strokeColor=#D6B656;fontColor=#D6B656;fontStyle=1;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="720" y="240" width="310" height="202" as="geometry"/></mxCell><mxCell id="a7" value='&lt;b&gt;7 · Sprint Planner&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;sprint goals &amp; epic start sprint&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="g_schedule"><mxGeometry x="20.0" y="44" width="270" height="62" as="geometry"/></mxCell><mxCell id="a8" value='&lt;b&gt;8 · Assignment Planner&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;matches tasks to team members&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="g_schedule"><mxGeometry x="20.0" y="120" width="270" height="62" as="geometry"/></mxCell><mxCell id="g_validate" value="Phase 4 · Validate" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;dashPattern=7 4;fillColor=none;strokeColor=#9673A4;fontColor=#9673A4;fontStyle=1;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1070" y="240" width="310" height="126" as="geometry"/></mxCell><mxCell id="a9" value='&lt;b&gt;9 · Project Validator&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;semantic review (advisory)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A4;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="g_validate"><mxGeometry x="20.0" y="44" width="270" height="62" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="orch" target="g_understand"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="orch" target="g_plan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="orch" target="g_schedule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="orch" target="g_validate"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>