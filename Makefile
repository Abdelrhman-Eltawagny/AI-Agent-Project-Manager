.PHONY: install mock test run serve chat docker-up clean

PY ?= python
DOC ?= examples/inputs/clinic_project.md
MODEL ?= qwen2.5:7b-instruct

install:
	$(PY) -m pip install -r requirements.txt

mock:  ## offline smoke test, no LLM needed
	$(PY) main.py --test --mock

test: mock  ## the server tests read the plan generated by the mock run
	$(PY) -m unittest discover -s tests -v

run:  ## plan a project with a local Ollama model: make run DOC=path.md MODEL=qwen2.5:7b
	$(PY) main.py --doc $(DOC) --model $(MODEL)

chat:
	$(PY) chat.py

serve:
	uvicorn server:app --host 0.0.0.0 --port 8000

docker-up:
	docker compose -f docker-compose.prod.yml up -d --build

clean:
	rm -rf outputs/* && touch outputs/.gitkeep
